DATABASE_URL="postgresql://sca:CHANGE_ME@localhost:5432/swiss_customs?schema=public"
# Nur setzen, wenn der Mandant der KI-Verarbeitung zugestimmt hat
ANTHROPIC_API_KEY=""
# 32 Byte, base64 – für AES-256-GCM-Verschlüsselung der Belege
FILE_ENCRYPTION_KEY=""
STORAGE_DIR="./storage"
DATABASE_URL_UNPOOLED="postgresql://sca:CHANGE_ME@localhost:5432/swiss_customs?schema=public"
# Schlüsselrotation (optional): aktuelle Schlüssel-ID und alter Schlüssel
# FILE_ENCRYPTION_KEY_ID="v2"
# FILE_ENCRYPTION_KEY_V1="<alter Schlüssel>"
# Schutz des täglichen Aufbewahrungs-Laufs (/api/cron/retention)
CRON_SECRET=""
# Modell für die KI-Erkennung (Standard: claude-opus-5-5)
# EXTRACTION_MODEL="claude-opus-5-5"
# Max. Upload je Datei in Byte (Vercel-Limit beachten)
# MAX_UPLOAD_BYTES="4194304"
